<Window x:Class="Meine_Erinnerungs_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Meine_Erinnerungs_app"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="900">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF0D47A1" Offset="0.0"/>
            <GradientStop Color="#FF1976D2" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,45,0,0">
            <StackPanel.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FF009AFE" Offset="1"/>
                </LinearGradientBrush>
            </StackPanel.Background>
            <TextBox Name="GrundTextBox" Width="300" Height="40" Margin="10" Text="Grund" Foreground="Gray" FontWeight="Bold" GotFocus="RemovePlaceholderText" LostFocus="AddPlaceholderText" TextAlignment="Center" VerticalContentAlignment="Center" BorderBrush="Gray" BorderThickness="1" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
            <DatePicker Name="DatumTextBox" Width="300" Height="40" Margin="10" SelectedDateChanged="DatumTextBox_SelectedDateChanged" Background="#FFF0F0F0" BorderBrush="Gray" BorderThickness="1"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                <ComboBox Name="StundenComboBox" Width="140" Height="40" Margin="5" Background="#FFF0F0F0" BorderBrush="Gray" BorderThickness="1">
                    <ComboBoxItem Content="00" />
                    <ComboBoxItem Content="01" />
                    <ComboBoxItem Content="02" />
                    <ComboBoxItem Content="03" />
                    <ComboBoxItem Content="04" />
                    <ComboBoxItem Content="05" />
                    <ComboBoxItem Content="06" />
                    <ComboBoxItem Content="07" />
                    <ComboBoxItem Content="08" />
                    <ComboBoxItem Content="09" />
                    <ComboBoxItem Content="10" />
                    <ComboBoxItem Content="11" />
                    <ComboBoxItem Content="12" />
                    <ComboBoxItem Content="13" />
                    <ComboBoxItem Content="14" />
                    <ComboBoxItem Content="15" />
                    <ComboBoxItem Content="16" />
                    <ComboBoxItem Content="17" />
                    <ComboBoxItem Content="18" />
                    <ComboBoxItem Content="19" />
                    <ComboBoxItem Content="20" />
                    <ComboBoxItem Content="21" />
                    <ComboBoxItem Content="22" />
                    <ComboBoxItem Content="23" />
                </ComboBox>
                <TextBlock Text=":" VerticalAlignment="Center" FontSize="20" Margin="5"/>
                <ComboBox Name="MinutenComboBox" Width="140" Height="40" Margin="5" Background="#FFF0F0F0" BorderBrush="Gray" BorderThickness="1">
                    <ComboBoxItem Content="00" />
                    <ComboBoxItem Content="05" />
                    <ComboBoxItem Content="10" />
                    <ComboBoxItem Content="15" />
                    <ComboBoxItem Content="20" />
                    <ComboBoxItem Content="25" />
                    <ComboBoxItem Content="30" />
                    <ComboBoxItem Content="35" />
                    <ComboBoxItem Content="40" />
                    <ComboBoxItem Content="45" />
                    <ComboBoxItem Content="50" />
                    <ComboBoxItem Content="55" />
                </ComboBox>
            </StackPanel>
            <Button Name="ConfirmButton" Content="TERMIN BESTÄTIGEN!" Width="150" Height="60" Margin="10" Click="Button_Click" Background="#FF1E90FF" Foreground="White" FontWeight="Bold">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Name="DeleteButton" Content="Termin entfernen" Width="150" Height="60" Margin="20" Click="Button_Click_1" Background="#FF1E90FF" Foreground="White" FontWeight="Bold" IsEnabled="False">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
        </StackPanel>
        <ListBox Name="ErgebnisListBox" Width="700" Height="211" Margin="0,462,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" SelectionChanged="ErgebnisListBox_SelectionChanged" d:ItemsSource="{d:SampleData ItemCount=5}" BorderBrush="Black" BorderThickness="3" Background="DarkGray">
            <ListBox.Effect>
                <DropShadowEffect/>
            </ListBox.Effect>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="3" Margin="2" Padding="10" Background="{Binding Background}" Width="658" HorizontalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Grund}" FontWeight="Bold" Grid.Column="0" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Datum}" Grid.Column="1" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Uhrzeit}" Grid.Column="2" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
