<Window x:Class="Meine_Erinnerungs_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Meine_Erinnerungs_app"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1E90FF" Offset="0.0"/>
            <GradientStop Color="#FF87CEFA" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10">
            <TextBox Name="GrundTextBox" Width="200" Height="30" Margin="10" Text="Grund" Foreground="Black" FontWeight="Bold" GotFocus="RemovePlaceholderText" LostFocus="AddPlaceholderText" TextAlignment="Center" VerticalContentAlignment="Center" Background="#FFF0F0F0" BorderBrush="Gray" BorderThickness="1"/>
            <TextBox Name="DatumTextBox" Width="200" Height="30" Margin="10" Text="Datum" Foreground="Black" FontWeight="Bold" GotFocus="RemovePlaceholderText" LostFocus="AddPlaceholderText" TextAlignment="Center" VerticalContentAlignment="Center" Background="#FFF0F0F0" BorderBrush="Gray" BorderThickness="1"/>
            <TextBox Name="UhrzeitTextBox" Width="200" Height="30" Margin="10" Text="Uhrzeit" Foreground="Black" FontWeight="Bold" GotFocus="RemovePlaceholderText" LostFocus="AddPlaceholderText" TextAlignment="Center" VerticalContentAlignment="Center" Background="#FFF0F0F0" BorderBrush="Gray" BorderThickness="1"/>
            <Button Content="GO!" Width="100" Height="50" Margin="10" Click="Button_Click" Background="#FF1E90FF" Foreground="White" FontWeight="Bold">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Content="Löschen" Width="100" Height="50" Margin="20" Click="Button_Click_1" Background="#FF1E90FF" Foreground="White" FontWeight="Bold">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
        </StackPanel>
    </Grid>
</Window>
