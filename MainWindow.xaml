<Window
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="Meine_Erinnerungs_app.MainWindow"
        Title="Erinnerungs-App" Width="1100" Height="900" WindowStartupLocation="CenterScreen" Background="#1A1A1A">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0D0D0D" Padding="25">
            <TextBlock Text="Erinnerungs-App" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF"/>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Input Form -->
            <StackPanel Grid.Column="0" Margin="25" VerticalAlignment="Top">
                <TextBlock Text="Meine Termine" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,15"/>

                <TextBlock Text="Beschreibung" FontSize="16" Foreground="#BDBDBD" Margin="0,0,0,5"/>
                <TextBox x:Name="GrundTextBox" Height="45" Padding="12" Background="#252525" Foreground="#FFFFFF" 
                         BorderBrush="#404040" BorderThickness="1" FontSize="14"/>
                <TextBlock Height="15"/>

                <TextBlock Text="Datum" FontSize="16" Foreground="#BDBDBD" Margin="0,0,0,5"/>
                <DockPanel Height="45">
                    <Button Content="Heute" Width="100" Click="HeuteKnopf_Klick" Background="Bisque"
                            Foreground="BlACK"  FontWeight="bold" FontSize="20"  DockPanel.Dock="Right" Margin="10,0,0,0"/>
                    <DatePicker x:Name="DatumTextBox" Background="#FFFFFF" Foreground="#000000" BorderBrush="#404040" 
                                BorderThickness="1" Padding="10" FontSize="16" Height="45" Width="290" RenderTransformOrigin="0.5,0.5">
                        <DatePicker.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform AngleY="-0.016"/>
                                <RotateTransform Angle="-0.236"/>
                                <TranslateTransform Y="-0.041"/>
                            </TransformGroup>
                        </DatePicker.RenderTransform>
                    </DatePicker>
                </DockPanel>
                <TextBlock Height="15"/>

                <TextBlock Text="Uhrzeit" FontSize="16" Foreground="#BDBDBD" Margin="0,0,0,5"/>
                <TextBlock Height="20"/>
            </StackPanel>

            <!-- Right: Termine List -->
            <Border Grid.Column="1" Margin="0,25,25,25" Background="#252525" BorderBrush="#404040" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#0D0D0D" Padding="15" BorderBrush="#404040" BorderThickness="0,0,0,1">
                        <TextBlock Text="Meine Termine" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>

                    <ListBox x:Name="ErgebnisListBox" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                             SelectionChanged="ErgebnisListe_AuswahlGeaendert" Padding="10" d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="ItemBorder" Background="{Binding Background}" CornerRadius="12" Padding="20" Margin="0,0,0,25" 
                                                    BorderBrush="{Binding BorderBrush}" BorderThickness="5" RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding ItemScale}" ScaleY="{Binding ItemScale}"/>
                                                </Border.RenderTransform>
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="MouseLeftButtonDown">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                               To="0.95" Duration="0:0:0.1" AutoReverse="True"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                               To="0.95" Duration="0:0:0.1" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                                <Border.Effect>
                                                    <DropShadowEffect x:Name="ItemShadow" BlurRadius="4" ShadowDepth="2" Opacity="0.3" Color="#000000"/>
                                                </Border.Effect>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Grund}" FontSize="18" FontWeight="Normal" Foreground="#FFFFFF" 
                                                               Margin="0,0,0,8" TextAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock x:Name="CountdownTextBlock" Text="{Binding CountdownText}" FontSize="16" Foreground="#FFD700" 
                                                               FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,8" RenderTransformOrigin="0.5,0.5">
                                                        <TextBlock.RenderTransform>
                                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                        </TextBlock.RenderTransform>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShouldPulseText}" Value="True">
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard Name="TextPulseStoryboard">
                                                                                <Storyboard RepeatBehavior="Forever">
                                                                                    <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                                                   From="1.0" To="1.15" Duration="0:0:0.6" AutoReverse="True">
                                                                                        <DoubleAnimation.EasingFunction>
                                                                                            <SineEase EasingMode="EaseInOut"/>
                                                                                        </DoubleAnimation.EasingFunction>
                                                                                    </DoubleAnimation>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                                                   From="1.0" To="1.15" Duration="0:0:0.6" AutoReverse="True">
                                                                                        <DoubleAnimation.EasingFunction>
                                                                                            <SineEase EasingMode="EaseInOut"/>
                                                                                        </DoubleAnimation.EasingFunction>
                                                                                    </DoubleAnimation>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                        <DataTrigger.ExitActions>
                                                                            <StopStoryboard BeginStoryboardName="TextPulseStoryboard"/>
                                                                        </DataTrigger.ExitActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ProgressBar Value="{Binding ProgressValue}" Height="10" Minimum="0" Maximum="100" 
                                                                 Margin="0,0,0,8" Background="#333333" Foreground="{Binding ProgressBarColor}" BorderThickness="0"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="Datum: " FontSize="16" Foreground="#BDBDBD"/>
                                                        <TextBlock Text="{Binding Datum}" FontSize="16" Foreground="#EEEEEE" Margin="0,0,20,0"/>
                                                        <TextBlock Text="Zeit: " FontSize="16" Foreground="#BDBDBD"/>
                                                        <TextBlock Text="{Binding Uhrzeit}" FontSize="16" Foreground="#EEEEEE"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>
            <Button x:Name="DeleteButton" Content="TERMIN LOESCHEN" Click="LoeschenKnopf_Klick" 
                    IsEnabled="False" Margin="25,580,25,25" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#D32F2F"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="20"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ButtonBorder" Background="#D32F2F" 
                                            CornerRadius="8" Padding="15" BorderThickness="2" BorderBrush="Transparent">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="3" Opacity="0.4" Color="#000000"/>
                                        </Border.Effect>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="ButtonBorder" 
                                                                       Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                       To="#EF5350" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="ButtonBorder" 
                                                                       Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                       To="#D32F2F" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="ButtonBorder" Property="Background" Value="#555555"/>
                                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="AddButton" Content="TERMIN HINZUFUEGEN" Click="HinzufuegenKnopf_Klick" 
                    Margin="25,466,25,138" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#388E3C"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="18"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ButtonBorder" Background="#388E3C" 
                                            CornerRadius="8" Padding="15" BorderThickness="2" BorderBrush="Transparent">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="3" Opacity="0.4" Color="#000000"/>
                                        </Border.Effect>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="ButtonBorder" 
                                                                       Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                       To="#43A047" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="ButtonBorder" 
                                                                       Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                       To="#388E3C" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <Border Background="#252525" BorderBrush="#404040" BorderThickness="1" CornerRadius="5" Padding="15" RenderTransformOrigin="0.5,0.5" Margin="24,269,26,256">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button Content="+" Height="25" Click="StundenHoch_Klick" Background="Transparent" Foreground="#42A5F5" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="StundenTextBox" Text="00" Height="35" Width="60" TextAlignment="Center" VerticalAlignment="Center" 
                                     Background="#0D47A1" Foreground="#FFFFFF" BorderThickness="0" FontSize="20" FontWeight="Bold" Margin="0,0,0,5" MaxLength="2"/>
                        <Button Content="-" Height="25" Click="StundenRunter_Klick" Background="Transparent" Foreground="#42A5F5" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text=":" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="5"/>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button Content="+" Height="25" Click="MinutenHoch_Klick" Background="Transparent" Foreground="#66BB6A" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="MinutenTextBox" Text="00" Height="35" Width="60" TextAlignment="Center" VerticalAlignment="Center" 
                                     Background="#1B5E20" Foreground="#FFFFFF" BorderThickness="0" FontSize="20" FontWeight="Bold" Margin="0,0,0,5" MaxLength="2"/>
                        <Button Content="-" Height="25" Click="MinutenRunter_Klick" Background="Transparent" Foreground="#66BB6A" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>

                    <TextBlock Grid.Column="3" Text=":" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="5"/>

                    <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button Content="+" Height="25" Click="SekundenHoch_Klick" Background="Transparent" Foreground="#EF5350" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="SekundenTextBox" Text="00" Height="35" Width="60" TextAlignment="Center" VerticalAlignment="Center" 
                                     Background="#B71C1C" Foreground="#FFFFFF" BorderThickness="0" FontSize="20" FontWeight="Bold" Margin="0,0,0,5" MaxLength="2"/>
                        <Button Content="-" Height="25" Click="SekundenRunter_Klick" Background="Transparent" Foreground="#EF5350" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
