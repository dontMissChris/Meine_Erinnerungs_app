<Window x:Class="Meine_Erinnerungs_app.ToastNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Erinnerung" Height="150" Width="350"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Topmost="True" ShowInTaskbar="False">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1E90FF" Offset="0.0"/>
            <GradientStop Color="#FF87CEFA" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid Margin="10">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="⏰ Erinnerung" FontSize="14" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock x:Name="MessageText" FontSize="18" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
            <Button Content="OK" Width="80" Height="30" Click="OkButton_Click"
                    Background="White" Foreground="#FF1E90FF" FontWeight="Bold"
                    HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
