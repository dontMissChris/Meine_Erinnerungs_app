<Window x:Class="Meine_Erinnerungs_app.ToastNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Erinnerung" 
        Width="350" 
        Height="120" 
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">
    <Border Background="#2D3E50" CornerRadius="10" Margin="10" BorderBrush="#34495E" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="315" ShadowDepth="5" Opacity="0.5" BlurRadius="10"/>
        </Border.Effect>
        <StackPanel Orientation="Vertical" Margin="20">
            <TextBlock Name="ReasonTextBlock" 
                       Text="Erinnerung" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       Margin="0,0,0,5"/>
            <TextBlock Name="DateTimeTextBlock" 
                       Text="Datum und Uhrzeit" 
                       FontSize="14" 
                       Foreground="#ECF0F1" 
                       Margin="0,0,0,10"/>
            <Button Content="✕ Schließen" 
                    Width="90" 
                    Height="30" 
                    HorizontalAlignment="Right" 
                    Click="CloseButton_Click" 
                    Background="#E74C3C" 
                    Foreground="White" 
                    FontWeight="Bold"
                    Cursor="Hand"
                    BorderThickness="0">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
        </StackPanel>
    </Border>
</Window>
