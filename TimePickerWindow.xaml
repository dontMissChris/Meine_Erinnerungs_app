        <Button Content="Bestätigen" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="5" Width="150" Height="30" Background="Green" HorizontalAlignment="Center" Click="ConfirmButton_Click"/>

        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <TextBlock x:Name="HoursTextBlock" VerticalAlignment="Center" Margin="5"/>
