<Window x:Class="Meine_Erinnerungs_app.AlarmWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ALARM!" Height="450" Width="600" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True" Background="#1E1E1E"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Grid.Row="0" Background="#D32F2F" Padding="30"><TextBlock Text="TERMIN ALARM!" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/></Border><StackPanel Grid.Row="1" Margin="40" VerticalAlignment="Center"><TextBlock x:Name="GrundText" FontSize="28" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/><TextBlock x:Name="ZeitText" FontSize="22" Foreground="#FFD700" TextAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,20"/><TextBlock Text="Der Termin ist JETZT!" FontSize="20" Foreground="#FF5252" FontWeight="Bold" TextAlignment="Center"/></StackPanel><Button x:Name="OkButton" Grid.Row="2" Content="OK VERSTANDEN" Width="200" Height="50" FontSize="18" FontWeight="Bold" Margin="30" Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand" Click="OkButton_Click"/></Grid></Window>
