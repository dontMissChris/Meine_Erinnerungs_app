<Window x:Class="Meine_Erinnerungs_app.AlarmWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ALARM!" Height="350" Width="500" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True" Background="#1E1E1E">
    <Grid x:Name="MainGrid"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#D32F2F" Padding="20"><TextBlock Text="ALARM" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/></Border>
        <StackPanel Grid.Row="1" Margin="30" VerticalAlignment="Center"><TextBlock x:Name="GrundText" FontSize="24" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/><TextBlock x:Name="ZeitText" FontSize="18" Foreground="#BBBBBB" TextAlignment="Center" Margin="0,0,0,10"/><TextBlock Text="Der Termin ist JETZT!" FontSize="16" Foreground="#FF5252" FontWeight="Bold" TextAlignment="Center"/></StackPanel>
        <Button x:Name="OkButton" Grid.Row="2" Content="OK" Width="120" Height="40" FontSize="16" FontWeight="Bold" Margin="20" Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand" Click="OkButton_Click"/></Grid></Window>
